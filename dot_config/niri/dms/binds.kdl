binds {
    Alt+C repeat=false hotkey-overlay-title="Clipboard Manager" { spawn "dms" "ipc" "call" "clipboard" "toggle"; }
    Alt+D repeat=false hotkey-overlay-title="Application Launcher" { spawn "dms" "ipc" "call" "spotlight" "toggle"; }
    Alt+Period hotkey-overlay-title="Notepad: Toggle" { spawn "dms" "ipc" "call" "notepad" "toggle"; }
    Alt+Shift+E repeat=false { spawn "dms" "ipc" "call" "powermenu" "toggle"; }
    Alt+Space repeat=false hotkey-overlay-title="Notification Center" { spawn "dms" "ipc" "call" "notifications" "toggle"; }
    Super+Ctrl+Q repeat=false allow-inhibiting=false hotkey-overlay-title="Lock Screen" { spawn "dms" "ipc" "call" "lock" "lock"; }
    Super+Shift+3 repeat=false { spawn "dms" "ipc" "call" "quickCapture" "screenshot" "full"; }
    Super+Shift+4 repeat=false { spawn "dms" "ipc" "call" "quickCapture" "screenshot" "region"; }
    XF86AudioLowerVolume allow-when-locked=true { spawn "dms" "ipc" "call" "audio" "decrement" "3"; }
    XF86AudioMute allow-when-locked=true { spawn "dms" "ipc" "call" "audio" "mute"; }
    XF86AudioNext allow-when-locked=true { spawn "dms" "ipc" "call" "mpris" "next"; }
    XF86AudioPause allow-when-locked=true { spawn "dms" "ipc" "call" "mpris" "playPause"; }
    XF86AudioPlay allow-when-locked=true { spawn "dms" "ipc" "call" "mpris" "playPause"; }
    XF86AudioPrev allow-when-locked=true { spawn "dms" "ipc" "call" "mpris" "previous"; }
    XF86AudioRaiseVolume allow-when-locked=true { spawn "dms" "ipc" "call" "audio" "increment" "3"; }
    XF86MonBrightnessDown allow-when-locked=true { spawn "dms" "ipc" "call" "brightness" "decrement" "5" ""; }
    XF86MonBrightnessUp allow-when-locked=true { spawn "dms" "ipc" "call" "brightness" "increment" "5" ""; }
    Alt+0 { focus-workspace 10; }
    Alt+1 { focus-workspace 1; }
    Alt+2 { focus-workspace 2; }
    Alt+3 { focus-workspace 3; }
    Alt+4 { focus-workspace 4; }
    Alt+5 { focus-workspace 5; }
    Alt+6 { focus-workspace 6; }
    Alt+7 { focus-workspace 7; }
    Alt+8 { focus-workspace 8; }
    Alt+9 { focus-workspace 9; }
    Alt+Shift+0 { move-window-to-workspace 10 focus=false; }
    Alt+Shift+1 { move-window-to-workspace 1 focus=false; }
    Alt+Shift+2 { move-window-to-workspace 2 focus=false; }
    Alt+Shift+3 { move-window-to-workspace 3 focus=false; }
    Alt+Shift+4 { move-window-to-workspace 4 focus=false; }
    Alt+Shift+5 { move-window-to-workspace 5 focus=false; }
    Alt+Shift+6 { move-window-to-workspace 6 focus=false; }
    Alt+Shift+7 { move-window-to-workspace 7 focus=false; }
    Alt+Shift+8 { move-window-to-workspace 8 focus=false; }
    Alt+Shift+9 { move-window-to-workspace 9 focus=false; }
    Super+Shift+Down repeat=false { move-workspace-down; }
    Super+Shift+Tab repeat=false { move-workspace-to-monitor-next; }
    Super+Shift+Up repeat=false { move-workspace-up; }
    Alt+Down { focus-window-down; }
    Alt+F11 { fullscreen-window; }
    Alt+Left { focus-column-left; }
    Alt+P repeat=false { spawn "~/.config/niri/scripts/pin-focused-window"; }
    Alt+Right { focus-column-right; }
    Alt+Shift+C repeat=false { center-column; }
    Alt+Shift+Down { move-window-down; }
    Alt+Shift+F { maximize-column; }
    Alt+Shift+Left { consume-or-expel-window-left; }
    Alt+Shift+P repeat=false { spawn "~/.config/niri/scripts/unpin-focused-window"; }
    Alt+Shift+R { switch-preset-column-width; }
    Alt+Shift+Right { consume-or-expel-window-right; }
    Alt+Shift+Space { toggle-window-floating; }
    Alt+Shift+T { toggle-column-tabbed-display; }
    Alt+Shift+Tab repeat=false { move-window-to-monitor-next; }
    Alt+Shift+Up { move-window-up; }
    Alt+Up { focus-window-up; }
    Alt+W { close-window; }
    Alt+grave repeat=false { spawn "~/.config/niri/scripts/focus-pinned-window"; }
    Alt+F repeat=false { spawn "dolphin"; }
    Alt+G repeat=false { spawn "flatpak" "run" "app.zen_browser.zen"; }
    Alt+T hotkey-overlay-title="Open Terminal" repeat=false { spawn "ghostty"; }
    Alt+Shift+Slash { show-hotkey-overlay; }
    Alt+Tab repeat=false { open-overview; }
}
