// Compositor: niri (scrolling Wayland compositor)
// Reference:  https://niri-wm.github.io/niri/Configuration:-Introduction.html

// remove CSD
prefer-no-csd

// compatibility with token serial switch to enable click and focus on notifications
debug {
    // Allows notification actions and window activation from the shell.
    honor-xdg-activation-with-invalid-serial
}

// disable topright hotcorners
gestures {
    hot-corners {
        off
    }
}


// ---------------------------------------------------------------------------
// Input
// ---------------------------------------------------------------------------

input {
    mod-key "Alt"

    keyboard {
        xkb { }
    }

    touchpad {
        tap
        natural-scroll
        scroll-factor 1.0
    }

    trackpoint {
        // Pointer movement speed. Keep scroll settings below separate.
        accel-speed -0.5
        accel-profile "adaptive"
        // niri 26.04 does not accept scroll-factor for trackpoint.
        scroll-method "on-button-down"
        scroll-button 274
    }
    //mouse {
	// MX Master 3 thumb wheel: double horizontal scroll distance
	//scroll-factor horizontal=0.5 vertical=1.0
    //}

    warp-mouse-to-focus mode="center-xy-always"
    focus-follows-mouse max-scroll-amount="0%"
    //workspace-auto-back-and-forth
}


// ---------------------------------------------------------------------------
// Input

// ---------------------------------------------------------------------------

// ---------------------------------------------------------------------------
// Outputs  ->  managed by DMS in dms/outputs.kdl (see include below)
// ---------------------------------------------------------------------------

// niri automatically disables eDP-1 when the lid is closed and re-enables it
// on open, so no explicit switch-events block is needed for lid handling.


// ---------------------------------------------------------------------------
// Switch Event
// ---------------------------------------------------------------------------
switch-events {
    lid-close { spawn "~/.config/niri/scripts/lid-close-policy"; }
}


// ---------------------------------------------------------------------------
// Autostart
// ---------------------------------------------------------------------------
// NOTE: DankMaterialShell runs as a systemd user service (dms.service), so it
// is NOT spawned here. The old Noctalia spawn ("qs -c noctalia-shell") was
// removed during the migration to DMS.

spawn-at-startup "~/.config/niri/scripts/start-fcitx5"
spawn-at-startup "~/.config/niri/scripts/float-zed-agent-notifications"
// Silence KDE's drkonqi crash-reporter under niri (no Plasma surface -> it
// crash-loops). Runtime mask self-clears on logout since Linger=no, so KDE
// keeps drkonqi.
spawn-at-startup "systemctl" "--user" "mask" "--runtime" "drkonqi-coredump-launcher@.service"
// starts kitty dropdown terminal at startup
spawn-at-startup "kitten" "quick-access-terminal" "--detach"

// ---------------------------------------------------------------------------
// Env
// ---------------------------------------------------------------------------
environment {
  EDITOR "nvim"
  XDG_CURRENT_DESKTOP "niri"
  QT_QPA_PLATFORM "wayland"
  ELECTRON_OZONE_PLATFORM_HINT "auto"
  QT_QPA_PLATFORMTHEME "kde"
  QT_QPA_PLATFORMTHEME_QT6 "kde"
  XDG_MENU_PREFIX "plasma-"
}

// ---------------------------------------------------------------------------
// Layout (custom bits; gaps/border widths/colors come from DMS includes below,
// which niri merges with this block)
// ---------------------------------------------------------------------------
layout {
    center-focused-column "on-overflow" // Don't auto-center focused column
    always-center-single-column

    // Keep an empty workspace at the very top of every monitor's workspace
    // list (in addition to the always-present empty one at the bottom), so
    // focus-workspace-up from the first workspace lands on a fresh empty one.
    empty-workspace-above-first

    struts {}
    default-column-width { proportion 0.33333; }
    preset-column-widths {
        proportion 0.25
        proportion 0.33333
        proportion 0.5
        proportion 0.66667
        proportion 1.0
    }

    tab-indicator {
        place-within-column
    }
}

// ---------------------------------------------------------------------------
// Window Rules (custom; global corner-radius/clip now come from dms/layout.kdl)
// ---------------------------------------------------------------------------

window-rule {
    // Zed agent waiting notifications report the same app ID as Zed, but no title.
    match app-id=r#"^dev\.zed\.Zed$"#
    exclude app-id=r#"^dev\.zed\.Zed$"# title=r#".+"#

    open-floating true
    open-focused false
    default-floating-position x=16 y=16 relative-to="bottom-right"
}


// ---------------------------------------------------------------------------
// Kitty quick-access terminal: match the DMS surface look
// (layer rules cannot be rounded/bordered by niri; this matches
//  DankMaterialShell's elevation + non-xray blur instead)
// ---------------------------------------------------------------------------
layer-rule {
    match namespace="^kitty-quick-access$"

    geometry-corner-radius 12      // shapes the blur + shadow only
    shadow {
        on
        softness 40
        spread 0
        offset x=0 y=6
        color "#00000066"
    }
    background-effect {
        blur true
        noise 0.03                 // colour banding
        saturation 1.15
    }
}



// ---------------------------------------------------------------------------
// Named Workspaces
// ---------------------------------------------------------------------------

